{
  "name": "bb-plugin-kodaforge",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "bb": ">=0.48",
    "bbPluginSdk": ">=0.6.104",
    "node": ">=20"
  },
  "bb": {
    "name": "KodaForge",
    "description": "KodaForge: a VS Code-style IDE for BB with Koda the bear. Monaco editor, explorer, search and replace, language servers, split terminals, source control, and agent chat, threads and workflows beside your code.",
    "branding": {
      "icon": "./assets/icon.svg"
    },
    "server": "./server.ts",
    "host": "./host.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-virtual": "^3.14.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "^0.52.2",
    "react-resizable-panels": "^4.17.0",
    "vscode-jsonrpc": "^10.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.104",
    "@radix-ui/react-alert-dialog": "^1.1.19",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-hover-card": "^1.1.19",
    "@radix-ui/react-menubar": "^1.1.20",
    "@radix-ui/react-navigation-menu": "^1.2.18",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.2",
    "hono": "^4.11.9",
    "material-icon-theme": "^5.40.0",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0",
    "vaul": "^1.1.2",
    "vitest": "^5.1.0"
  },
  "description": "KodaForge: a VS Code-style IDE for BB with Koda the bear. Monaco editor, explorer, search and replace, language servers, split terminals, source control, and agent chat, threads and workflows beside your code.",
  "license": "MIT",
  "scripts": {
    "build:monaco": "node scripts/build-monaco.mjs && node scripts/build-icons.mjs",
    "build": "npm run build:monaco && bb plugin build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "files": [
    "dist",
    "monaco",
    "server.ts",
    "host.ts",
    "app.tsx",
    "contract.ts",
    "components",
    "lib",
    "hooks",
    "README.md",
    "LICENSE",
    "assets",
    "marketplace.json",
    "CHANGELOG.md"
  ],
  "keywords": [
    "bb-plugin",
    "ide",
    "editor",
    "monaco",
    "vscode",
    "lsp",
    "terminal",
    "git",
    "koda"
  ],
  "homepage": "https://github.com/Kodaks94/bb-plugin-kodaforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kodaks94/bb-plugin-kodaforge.git"
  },
  "bugs": {
    "url": "https://github.com/Kodaks94/bb-plugin-kodaforge/issues"
  },
  "author": {
    "name": "Mahrad Pisheh Var",
    "url": "https://github.com/Kodaks94"
  }
